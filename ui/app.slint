import { Button, ScrollView, ListView } from "std-widgets.slint";

export struct ResultItem {
    path: string,
    filename: string,
    extension: string,
    size_str: string,
    mod_time_str: string,
    is_ocr: bool,
    highlight: string,
}

export struct FolderItem {
    path: string,
}

export struct DuplicateFileItem {
    path: string,
    size_str: string,
}

export struct DuplicateGroupItem {
    hash_short: string,
    size_str: string,
    wasted_str: string,
    count: int,
    first_path: string,
    second_path: string,
}

export component AppWindow inherits Window {
    title: "DocSearch — Desktop Document Search";
    min-width: 750px;
    min-height: 550px;
    preferred-width: 950px;
    preferred-height: 700px;
    background: root.bg_window;
    default-font-family: "sans-serif";

    // Callbacks to Rust
    callback search_query_changed(string);
    callback add_folder_clicked();
    callback remove_folder(string);
    callback trigger_rescan();
    callback refresh_duplicates();
    callback open_file(string);
    callback show_in_folder(string);
    callback delete_duplicate_file(string);
    callback toggle_theme();

    // Properties bound from Rust
    in-out property <string> search_text: "";
    in-out property <string> status_text: "Idle";
    in-out property <bool> is_indexing: false;
    in-out property <string> metrics_text: "";
    in-out property <bool> has_results: false;
    in-out property <int> folder_count: 0;
    in-out property <bool> has_pdf_tool: true;

    in-out property <bool> show_folders: false;
    in-out property <bool> show_duplicates: false;
    in-out property <string> duplicates_summary: "No duplicates found";

    in-out property <[ResultItem]> results: [];
    in-out property <[FolderItem]> folders: [];
    in-out property <[DuplicateGroupItem]> duplicate_groups: [];

    // Theme properties bound from Rust
    in-out property <bool> is_dark: true;
    in-out property <string> theme_mode: "auto";
    in-out property <string> theme_button_text: "🌓 Auto";

    // Theme palette
    property <color> bg_window: root.is_dark ? #11141c : #f8fafc;
    property <color> bg_card: root.is_dark ? #171c26 : #ffffff;
    property <color> bg_card_secondary: root.is_dark ? #1e2433 : #f1f5f9;
    property <color> bg_input: root.is_dark ? #1a202c : #ffffff;
    property <color> bg_badge: root.is_dark ? #252d3d : #e2e8f0;
    property <color> bg_badge_ext: root.is_dark ? #222b3b : #e0f2fe;
    property <color> bg_snippet: root.is_dark ? #11151f : #f1f5f9;
    property <color> bg_btn_action: root.is_dark ? #1e293b : #f1f5f9;
    property <color> bg_status: root.is_dark ? #1a202c : #ffffff;
    property <color> bg_btn_nav: root.is_dark ? #1e2433 : #ffffff;
    property <color> bg_btn_clear: root.is_dark ? #2d3748 : #e2e8f0;

    property <color> border_card: root.is_dark ? #263042 : #e2e8f0;
    property <color> border_drawer: root.is_dark ? #2b3547 : #e2e8f0;
    property <color> border_input: root.is_dark ? #374151 : #cbd5e1;
    property <color> border_btn: root.is_dark ? #374151 : #cbd5e1;
    property <color> border_action: root.is_dark ? #334155 : #cbd5e1;

    property <color> text_title: root.is_dark ? #ffffff : #0f172a;
    property <color> text_badge: root.is_dark ? #94a3b8 : #475569;
    property <color> text_badge_ext: root.is_dark ? #60a5fa : #0369a1;
    property <color> text_primary: root.is_dark ? #f1f5f9 : #1e293b;
    property <color> text_secondary: root.is_dark ? #cbd5e1 : #334155;
    property <color> text_muted: root.is_dark ? #94a3b8 : #64748b;
    property <color> text_link: root.is_dark ? #38bdf8 : #0284c7;
    property <color> text_status: root.is_dark ? #cbd5e1 : #334155;
    property <color> text_action: root.is_dark ? #e2e8f0 : #1e293b;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header bar
        HorizontalLayout {
            height: 42px;
            spacing: 12px;
            alignment: space-between;

            // Brand
            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "🔍";
                    font-size: 24px;
                    vertical-alignment: center;
                }

                Text {
                    text: "DocSearch";
                    font-size: 20px;
                    font-weight: 700;
                    color: root.text_title;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 52px;
                    height: 22px;
                    border-radius: 4px;
                    background: root.bg_badge;
                    y: (parent.height - self.height) / 2;

                    Text {
                        text: "v0.2.4";
                        font-size: 11px;
                        font-weight: 600;
                        color: root.text_badge;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Actions & Status
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                // Status Pill
                Rectangle {
                    border-radius: 14px;
                    background: root.bg_status;
                    border-width: 1px;
                    border-color: root.is_indexing ? #f59e0b : root.border_btn;
                    height: 28px;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.is_indexing ? #f59e0b : #10b981;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.status_text;
                            font-size: 12px;
                            color: root.text_status;
                            vertical-alignment: center;
                        }
                    }
                }

                // Theme Toggle Button
                Rectangle {
                    border-radius: 6px;
                    background: root.bg_btn_nav;
                    border-width: 1px;
                    border-color: root.border_btn;
                    height: 32px;
                    y: (parent.height - self.height) / 2;

                    TouchArea {
                        clicked => {
                            root.toggle_theme();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 4px;
                        Text {
                            text: root.theme_button_text;
                            font-size: 13px;
                            font-weight: 500;
                            color: root.text_primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Duplicates Toggle Button
                Rectangle {
                    border-radius: 6px;
                    background: root.show_duplicates ? #4338ca : root.bg_btn_nav;
                    border-width: 1px;
                    border-color: root.border_btn;
                    height: 32px;
                    y: (parent.height - self.height) / 2;

                    TouchArea {
                        clicked => {
                            root.show_duplicates = !root.show_duplicates;
                            if (root.show_duplicates) {
                                root.show_folders = false;
                                root.refresh_duplicates();
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: "📑 Duplicates";
                            font-size: 13px;
                            font-weight: 500;
                            color: root.show_duplicates ? #ffffff : root.text_primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Folders Toggle Button
                Rectangle {
                    border-radius: 6px;
                    background: root.show_folders ? #4338ca : root.bg_btn_nav;
                    border-width: 1px;
                    border-color: root.border_btn;
                    height: 32px;
                    y: (parent.height - self.height) / 2;

                    TouchArea {
                        clicked => {
                            root.show_folders = !root.show_folders;
                            if (root.show_folders) {
                                root.show_duplicates = false;
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: "📁 Folders (" + root.folder_count + ")";
                            font-size: 13px;
                            font-weight: 500;
                            color: root.show_folders ? #ffffff : root.text_primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Folders Drawer
        if root.show_folders : Rectangle {
            border-radius: 8px;
            background: root.bg_card;
            border-width: 1px;
            border-color: root.border_drawer;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        Text {
                            text: "Indexed Folders";
                            font-size: 15px;
                            font-weight: 600;
                            color: root.text_title;
                        }
                        Text {
                            text: "Only documents within these folders will be indexed";
                            font-size: 12px;
                            color: root.text_muted;
                        }
                    }

                    // Native Folder Picker Button (No text input!)
                    Rectangle {
                        border-radius: 6px;
                        background: #4f46e5;
                        height: 32px;

                        TouchArea {
                            clicked => { root.add_folder_clicked(); }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 6px;
                            Text {
                                text: "📂 + Add Folder (Native Picker)";
                                font-size: 13px;
                                font-weight: 600;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Folder list
                for folder in root.folders : Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: root.bg_card_secondary;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        Text {
                            text: "📁 " + folder.path;
                            font-size: 13px;
                            color: root.text_primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Rectangle {
                            width: 70px;
                            height: 24px;
                            border-radius: 4px;
                            background: root.is_dark ? #3f1d24 : #fee2e2;
                            y: (parent.height - self.height) / 2;

                            TouchArea {
                                clicked => { root.remove_folder(folder.path); }
                            }

                            Text {
                                text: "Remove";
                                font-size: 11px;
                                font-weight: 600;
                                color: root.is_dark ? #f87171 : #dc2626;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if root.folders.length == 0 : Text {
                    text: "No folders added yet. Click '+ Add Folder' above to choose a folder to index.";
                    font-size: 13px;
                    color: root.text_muted;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        border-radius: 6px;
                        background: #d97706;
                        height: 30px;

                        TouchArea {
                            clicked => { root.trigger_rescan(); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: "🔄 Trigger Re-scan";
                                font-size: 12px;
                                font-weight: 600;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Duplicates Drawer
        if root.show_duplicates : Rectangle {
            border-radius: 8px;
            background: root.bg_card;
            border-width: 1px;
            border-color: root.border_drawer;
            max-height: 280px;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        Text {
                            text: "Duplicate Document Detection";
                            font-size: 15px;
                            font-weight: 600;
                            color: root.text_title;
                        }
                        Text {
                            text: root.duplicates_summary;
                            font-size: 12px;
                            color: root.text_link;
                        }
                    }

                    Rectangle {
                        border-radius: 6px;
                        background: root.bg_btn_nav;
                        border-width: 1px;
                        border-color: root.border_btn;
                        height: 30px;

                        TouchArea {
                            clicked => { root.refresh_duplicates(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "🔄 Refresh";
                                font-size: 12px;
                                color: root.text_primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                ScrollView {
                    VerticalLayout {
                        spacing: 8px;

                        for grp in root.duplicate_groups : Rectangle {
                            border-radius: 6px;
                            background: root.bg_card_secondary;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Hash: " + grp.hash_short + " • Size: " + grp.size_str + " • Wasted: " + grp.wasted_str;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.is_dark ? #fbbf24 : #d97706;
                                    }
                                }

                                if grp.first_path != "" : HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "[1] " + grp.first_path;
                                        font-size: 11px;
                                        color: root.text_secondary;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        width: 45px;
                                        height: 20px;
                                        background: #2563eb;
                                        border-radius: 3px;
                                        TouchArea { clicked => { root.open_file(grp.first_path); } }
                                        Text { text: "Open"; font-size: 10px; color: #fff; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }

                                if grp.second_path != "" : HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "[2] " + grp.second_path;
                                        font-size: 11px;
                                        color: root.text_secondary;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        width: 45px;
                                        height: 20px;
                                        background: #2563eb;
                                        border-radius: 3px;
                                        TouchArea { clicked => { root.open_file(grp.second_path); } }
                                        Text { text: "Open"; font-size: 10px; color: #fff; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        width: 50px;
                                        height: 20px;
                                        background: #dc2626;
                                        border-radius: 3px;
                                        TouchArea { clicked => { root.delete_duplicate_file(grp.second_path); } }
                                        Text { text: "Delete"; font-size: 10px; color: #fff; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Search Input Bar
        Rectangle {
            height: 48px;
            border-radius: 8px;
            background: root.bg_input;
            border-width: 1px;
            border-color: root.border_input;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                Text {
                    text: "🔍";
                    font-size: 18px;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.search_text;
                    font-size: 15px;
                    color: root.text_title;
                    vertical-alignment: center;
                    edited => { root.search_query_changed(self.text); }
                }

                if root.search_text != "" : Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: root.bg_btn_clear;
                    y: (parent.height - self.height) / 2;

                    TouchArea {
                        clicked => {
                            root.search_text = "";
                            root.search_query_changed("");
                        }
                    }

                    Text {
                        text: "✕";
                        font-size: 12px;
                        color: root.text_muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Metrics Bar
        if root.metrics_text != "" : HorizontalLayout {
            height: 22px;
            Text {
                text: root.metrics_text;
                font-size: 12px;
                color: root.text_muted;
                vertical-alignment: center;
            }
        }

        // PDF tool tip banner (shown only if no PDF extractor is installed)
        if !root.has_pdf_tool : Rectangle {
            height: 30px;
            border-radius: 6px;
            background: #2a1f11;
            border-width: 1px;
            border-color: #78350f;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                Text {
                    text: "📄 Tip: Install 'poppler-utils' or 'ghostscript' to enable indexing and searching PDF documents.";
                    font-size: 11px;
                    color: #fde047;
                    vertical-alignment: center;
                }
            }
        }

        // Results Section
        ScrollView {
            VerticalLayout {
                spacing: 10px;
                padding-bottom: 20px;

                for item in root.results : Rectangle {
                    border-radius: 8px;
                    background: root.bg_card;
                    border-width: 1px;
                    border-color: root.border_card;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        // Top row: extension badge, filename, OCR badge, open buttons
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 8px;

                                // Extension badge
                                Rectangle {
                                    border-radius: 4px;
                                    background: root.bg_badge_ext;
                                    height: 22px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: item.extension;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: root.text_badge_ext;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Filename
                                Text {
                                    text: item.filename;
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: root.text_link;
                                    vertical-alignment: center;
                                }

                                if item.is_ocr : Rectangle {
                                    border-radius: 4px;
                                    background: root.is_dark ? #064e3b : #d1fae5;
                                    height: 20px;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: "OCR";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: root.is_dark ? #34d399 : #065f46;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Open actions
                            HorizontalLayout {
                                spacing: 6px;

                                Rectangle {
                                    border-radius: 4px;
                                    background: root.bg_btn_action;
                                    border-width: 1px;
                                    border-color: root.border_action;
                                    height: 24px;

                                    TouchArea {
                                        clicked => { root.open_file(item.path); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "Open";
                                            font-size: 11px;
                                            font-weight: 500;
                                            color: root.text_action;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    border-radius: 4px;
                                    background: root.bg_btn_action;
                                    border-width: 1px;
                                    border-color: root.border_action;
                                    height: 24px;

                                    TouchArea {
                                        clicked => { root.show_in_folder(item.path); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "Folder";
                                            font-size: 11px;
                                            font-weight: 500;
                                            color: root.text_action;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Path & meta info
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: item.path;
                                font-size: 12px;
                                color: root.text_muted;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: item.size_str + " • " + item.mod_time_str;
                                font-size: 11px;
                                color: root.text_muted;
                            }
                        }

                        // Snippet highlight
                        if item.highlight != "" : Rectangle {
                            border-radius: 4px;
                            background: root.bg_snippet;

                            HorizontalLayout {
                                padding: 8px;
                                Text {
                                    text: item.highlight;
                                    font-size: 12px;
                                    color: root.text_secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Empty state
                if !root.has_results && root.search_text == "" : Rectangle {
                    height: 220px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "📂";
                            font-size: 40px;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Type a keyword above to search indexed documents";
                            font-size: 14px;
                            font-weight: 500;
                            color: root.text_muted;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "💡 Supports: path:Dropbox, folder:Project, type:pdf, type:code, size:>1MB, size:<500KB";
                            font-size: 12px;
                            color: root.text_link;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Use the '📁 Folders' button above to configure which directories to monitor.";
                            font-size: 12px;
                            color: root.text_muted;
                            horizontal-alignment: center;
                        }
                    }
                }

                if !root.has_results && root.search_text != "" : Rectangle {
                    height: 180px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "🔎 No matches found";
                            font-size: 15px;
                            font-weight: 600;
                            color: root.text_muted;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Try searching for another term, or verify folders are indexed.";
                            font-size: 12px;
                            color: root.text_muted;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
